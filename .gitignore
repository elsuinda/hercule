# Hercule - proyecto

# logs de ejecucion de los instaladores
*.log
hercule-install.log
hercule-tools.log

# temporales
*.tmp
*.bak
*~
__pycache__/
*.pyc

# empaquetados
*.zip

# sistema
.DS_Store
Thumbs.db

# carpetas de trabajo del operador: se versiona la estructura (el LEEME placeholder),
# pero NUNCA el contenido real de casos/evidencia/informes emitidos.
documentos-base/*/casos/*
documentos-base/forense/evidencia/*
documentos-base/informes/emitidos/*
!documentos-base/*/casos/LEEME.txt
!documentos-base/forense/evidencia/LEEME.txt
!documentos-base/informes/emitidos/LEEME.txt
